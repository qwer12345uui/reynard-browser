<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>application-identifier</key>
    <string>com.minh-ton.Reynard.Helper</string>
	<key>get-task-allow</key>
	<true/>
    <key>com.apple.developer.kernel.extended-virtual-addressing</key>
    <true/>
	<key>com.apple.developer.kernel.increased-memory-limit</key>
    <true/>
		<key>platform-application</key>
    <true/>
	<!-- Keep the Gecko content extension aligned with the RootHide-safe
	     entitlement set used by the main TrollStore application. -->
	<key>com.apple.private.security.no-sandbox</key>
    <true/>
	<key>com.apple.private.security.storage.AppBundles</key>
    <true/>
		<!-- Fork fix: grant the web content process the same storage access as the

	     main app. The author builds with a development identity, which implicitly
	     lets the embedded extension reach the app's containers; the unsigned CI
	     build does not, so uploads (reads) and downloads (writes) fail. These two
	     permissions let the helper read staged files and write downloaded files. -->
	<key>com.apple.private.security.storage.AppDataContainers</key>
    <true/>
    <key>com.apple.private.security.storage.MobileDocuments</key>
    <true/>
</dict>
</plist>
