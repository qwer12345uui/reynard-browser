    "Use %%s for search terms, as in example.com⁠/⁠search⁠?⁠q⁠=⁠%%s.": {
      "comment": "Literal %s, word joiners",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %%s for search terms, as in example.com⁠/⁠search⁠?⁠q⁠=⁠%%s."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser %%s comme termes de recherche, par exemple : example.com/search?q=%%s"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "\nexample.com/search?q=%%s のように、検索語句には %%s を使用してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте %%s для поисковых запросов, например: example.com⁠/⁠search⁠?⁠q⁠=⁠%%s.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用%%s作为搜索词，例如 example.com⁠/⁠search⁠?⁠q⁠=⁠%%s。"
          }
        }
      }
    },
