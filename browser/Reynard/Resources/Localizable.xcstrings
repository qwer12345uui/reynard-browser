    "%@ are disabled for Reynard. Open Settings to allow access.": {
      "comment": "Permission list placeholder",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ are disabled for Reynard. Open Settings to allow access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sont désactivés pour Reynard. Ouvrez les paramètres pour autoriser l'accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は無効です。設定を開いて許可してください"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Reynard отключены: %@. Разрешите доступ в Настройках.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已对 Reynard 停用。请打开“设置”以允许访问。"
          }
        }
      }
    },
    "%@ has been updated. Approve the additional permissions before the updated version is installed. Dismissing this prompt keeps your current add-on version.": {
      "comment": "Add-on name",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been updated. Approve the additional permissions before the updated version is installed. Dismissing this prompt keeps your current add-on version."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a reçu une mise à jour. Confirmez les permissions supplémentaires avant que la nouvelle version soit installée. Fermez ce message pour conserver la version actuelle. "
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@が更新されました。新しいバージョンをインストールする前に追加の権限を許可してください。許可しない場合現場のバージョンが使われます"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приложение %@ обновлено. Утвердите новые разрешения перед установкой. Отмена запроса сохранит текущую версию дополнения.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已更新。请先批准额外权限，然后再安装更新版本。关闭此提示将保留当前附加组件版本。"
          }
        }
      }
    },
    "%@ is disabled for Reynard. Open Settings to allow access.": {
      "comment": "Permission list placeholder",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is disabled for Reynard. Open Settings to allow access."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est désactivé pour Reynard. Ouvrez les paramètres pour donner accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@は無効です。設定を開いて許可してください"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для Reynard отключено: %@. Разрешите доступ в Настройках.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已对 Reynard 停用。请打开“设置”以允许访问。"
