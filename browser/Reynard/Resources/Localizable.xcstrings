    "Allow %@ to access apps and services on devices connected to your local network?": {
      "comment": "Website host",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow %@ to access apps and services on devices connected to your local network?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voulez-vous autoriser %@ à accéder aux applications et services sur les appareils connectés à votre réseau local ?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@にローカルネットワークに接続されてるデバイスやサービスへのアクセスを許可する"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Разрешить %@ доступ к приложениям и службам на устройствах, подключённых к вашей локальной сети?\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许“%@”访问连接到你本地网络的设备上的 App 和服务吗？"
          }
        }
      }
    },
