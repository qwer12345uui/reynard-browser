    "This build does not support in-app updates. Visit the project's Releases page to download the latest version of the app.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This build does not support in-app updates. Visit the project's Releases page to download the latest version of the app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce build ne prend pas en charge les mises à jour dans l'application. Veuillez visites l'onglet Releases du projet pour télécharger la dernière version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このビルドはアプリ内更新に対応していません。プロジェクトのリリースページを訪れてアプリの最新版を入手してください。"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Эта сборка не поддерживает обновления в приложении. Перейдите на страницу релизов проекта, чтобы скачать последнюю версию приложения.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此构建不支持 App 内更新。请前往项目的 Releases 页面下载最新版本。"
          }
        }
      }
    },
    "This will clear selected browsing data. This action cannot be undone.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will clear selected browsing data. This action cannot be undone."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci effacera les données de navigation sélectionnées. Cette action ne pourra pas être annulée."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択されたブラウジングデータは削除されます。この作業は取り消せません。"
