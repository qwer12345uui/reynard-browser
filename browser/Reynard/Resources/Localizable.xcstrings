    "You may want to block access if it’s not clear why %@ needs this data.": {
      "comment": "Third-party host",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You may want to block access if it’s not clear why %@ needs this data."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si la raison pour laquelle %@ a besoin de cette permission n'est pas claire, vous pouvez y bloquer l'accès."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@がこのデータをどのような用途で使用するか不明な場合アクセスをブロックすることをおすすめします"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Возможно, стоит запретить доступ, если вам непонятно, зачем %@ нужны эти данные.\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果不清楚“%@”为何需要这些数据，你可能需要阻止访问。"
