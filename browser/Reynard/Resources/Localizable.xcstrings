            "value": "%@の\n\n"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "из%@\n"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "，共 %@"
          }
        }
      }
    },
