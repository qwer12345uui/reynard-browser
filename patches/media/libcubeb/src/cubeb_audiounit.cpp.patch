+static int
+audiounit_create_output_converter(cubeb_stream * stm, cubeb_stream * voice,
+                                  UInt32 max_frames)
+{
+  AudioComponentDescription description = {};
+  description.componentType = kAudioUnitType_FormatConverter;
+  description.componentSubType = kAudioUnitSubType_AUConverter;
+  description.componentManufacturer = kAudioUnitManufacturer_Apple;
+  AudioComponent component = AudioComponentFindNext(nullptr, &description);
+  if (!component) {
+    return CUBEB_ERROR;
+  }
+
+  OSStatus r = AudioComponentInstanceNew(component, &stm->output_converter);
+  if (r != noErr) {
+    LOG("AudioComponentInstanceNew/output converter rv=%d", r);
+    return CUBEB_ERROR;
+  }
+
+  r = AudioUnitSetProperty(stm->output_converter,
+                           kAudioUnitProperty_StreamFormat,
+                           kAudioUnitScope_Input, AU_OUT_BUS, &stm->output_desc,
+                           sizeof(stm->output_desc));
+  if (r != noErr) {
+    LOG("AudioUnitSetProperty/converter input format rv=%d", r);
+    return CUBEB_ERROR;
+  }
+
+  r = AudioUnitSetProperty(stm->output_converter,
+                           kAudioUnitProperty_StreamFormat,
+                           kAudioUnitScope_Output, AU_OUT_BUS,
+                           &voice->output_desc, sizeof(voice->output_desc));
+  if (r != noErr) {
+    LOG("AudioUnitSetProperty/converter output format rv=%d", r);
+    return CUBEB_ERROR;
+  }
+
+  r = AudioUnitSetProperty(
+      stm->output_converter, kAudioUnitProperty_MaximumFramesPerSlice,
+      kAudioUnitScope_Global, AU_OUT_BUS, &max_frames, sizeof(max_frames));
+  if (r != noErr) {
+    LOG("AudioUnitSetProperty/converter maximum frames rv=%d", r);
+    return CUBEB_ERROR;
+  }
+
+  AURenderCallbackStruct callback = {audiounit_output_callback, stm};
+  r = AudioUnitSetProperty(
+      stm->output_converter, kAudioUnitProperty_SetRenderCallback,
+      kAudioUnitScope_Input, AU_OUT_BUS, &callback, sizeof(callback));
+  if (r != noErr) {
+    LOG("AudioUnitSetProperty/converter render callback rv=%d", r);
+    return CUBEB_ERROR;
+  }
+
+  r = AudioUnitInitialize(stm->output_converter);
+  if (r != noErr) {
+    LOG("AudioUnitInitialize/output converter rv=%d", r);
+    return CUBEB_ERROR;
+  }
+
+  return CUBEB_OK;
+}
