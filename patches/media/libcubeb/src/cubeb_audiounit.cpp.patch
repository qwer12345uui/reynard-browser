+static void
+audiounit_stop_and_notify_from_callback(cubeb_stream * stm,
+                                        cubeb_state state)
+{
+  if (std::atomic_exchange(&stm->shutdown, true)) {
+    return;
+  }
+
+  // AudioOutputUnitStop joins the I/O thread, so it must run after the
+  // callback returns.
+  dispatch_async(stm->context->serial_queue, ^() {
+    {
+      auto_lock context_lock(stm->context->mutex);
+      if (stm->destroy_pending || stm->context->reset_pending) {
+        return;
+      }
+
+      audiounit_stream_stop_internal(stm);
+    }
+    stm->state_callback(stm, stm->user_ptr, state);
+  });
+}
+#endif
