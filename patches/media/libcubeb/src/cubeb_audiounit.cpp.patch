+static void
+audiounit_destroy_output_converter(cubeb_stream * stm)
+{
+  if (stm->output_converter) {
+    AudioUnitUninitialize(stm->output_converter);
+    AudioComponentInstanceDispose(stm->output_converter);
+    stm->output_converter = nullptr;
+  }
