+static void
+audiounit_restore_output(cubeb_stream * voice)
+{
+  cubeb * context = voice->context;
+  std::lock_guard<std::mutex> lock(context->output_mutex);
+  if (context->voice_stream != voice) {
+    return;
+  }
+
+  context->voice_stream = nullptr;
+
+  bool resume_output = !context->interrupted && !context->reconfiguring;
+  if (resume_output) {
+    resume_output = !cubeb_ios_audio_session_interrupted();
+  }
+
+  for (cubeb_stream * stream : context->output_streams) {
+    audiounit_destroy_output_converter(stream);
+    if (resume_output && !stream->shutdown) {
+      OSStatus r = AudioOutputUnitStart(stream->output_unit);
+      if (r != noErr) {
+        audiounit_stop_and_notify_from_callback(stream, CUBEB_STATE_ERROR);
+      }
+    }
+  }
+}
+
+static int
+audiounit_share_output(cubeb_stream * voice)
+{
+  cubeb * context = voice->context;
+  assert(!context->voice_stream);
+
+  UInt32 max_frames;
+  UInt32 size = sizeof(max_frames);
+  OSStatus r = AudioUnitGetProperty(
+      voice->input_unit, kAudioUnitProperty_MaximumFramesPerSlice,
+      kAudioUnitScope_Global, AU_OUT_BUS, &max_frames, &size);
+  if (r != noErr) {
+    return CUBEB_ERROR;
+  }
+
+  for (cubeb_stream * stream : context->output_streams) {
+    if (audiounit_create_output_converter(stream, voice, max_frames) !=
+        CUBEB_OK) {
+      for (cubeb_stream * prepared : context->output_streams) {
+        audiounit_destroy_output_converter(prepared);
+      }
+      return CUBEB_ERROR;
+    }
+  }
+
+  context->mix_buffer.resize(max_frames * voice->output_desc.mBytesPerFrame);
+  context->voice_stream = voice;
+
+  for (cubeb_stream * stream : context->output_streams) {
+    r = AudioOutputUnitStop(stream->output_unit);
+    if (r != noErr) {
+      audiounit_restore_output(voice);
+      return CUBEB_ERROR;
+    }
+    audiounit_reserve_output_buffer(stream, stream->output_converter);
+  }
+
+  if (has_output(voice)) {
+    audiounit_reserve_output_buffer(voice, voice->input_unit);
+  }
+
+  return CUBEB_OK;
+}
+
+static bool
+audiounit_unregister_output(cubeb_stream * stm)
+{
+  cubeb * context = stm->context;
+  std::lock_guard<std::mutex> lock(context->output_mutex);
+  auto & streams = context->output_streams;
+  streams.erase(std::remove(streams.begin(), streams.end(), stm),
+                streams.end());
+
+  bool was_shared = stm->output_converter != nullptr;
+  audiounit_destroy_output_converter(stm);
+  return was_shared;
+}
