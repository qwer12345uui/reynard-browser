+static void
+audiounit_reserve_output_buffer(cubeb_stream * stm, AudioUnit unit)
+{
+  if (!stm->mixer) {
+    return;
+  }
+
+  UInt32 max_frames;
+  UInt32 size = sizeof(max_frames);
+  OSStatus r = AudioUnitGetProperty(
+      unit, kAudioUnitProperty_MaximumFramesPerSlice, kAudioUnitScope_Global,
+      AU_OUT_BUS, &max_frames, &size);
+  assert(r == noErr);
+
+  size_t bytes = max_frames * stm->output_stream_params.channels *
+                 cubeb_sample_size(stm->output_stream_params.format);
+  if (bytes > stm->temp_buffer_size) {
+    stm->temp_buffer.reset(new uint8_t[bytes]);
+    stm->temp_buffer_size = bytes;
+  }
+}
