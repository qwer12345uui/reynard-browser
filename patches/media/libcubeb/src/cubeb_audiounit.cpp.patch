+static void
+audiounit_notify_device_changed(cubeb * context)
+{
+  for (cubeb_stream * stream : context->streams) {
+    if (stream->destroy_pending) {
+      continue;
+    }
+
+    if (stream->shutdown && !context->reset_pending) {
+      continue;
+    }
+
+    auto_lock lock(stream->device_changed_callback_lock);
+    if (stream->device_changed_callback) {
+      stream->device_changed_callback(stream->user_ptr);
+    }
+  }
+}
+
+static void
+audiounit_reconfigure_context(cubeb * context)
+{
+  context->mutex.assert_current_thread_owns();
+
+  if (!context->reconfigure_pending) {
+    return;
+  }
+
+  if (context->interrupted || cubeb_ios_audio_session_interrupted()) {
+    return;
+  }
+
+  context->reconfiguring = true;
+
+  for (cubeb_stream * stream : context->streams) {
+    if (!stream->suspended) {
+      audiounit_stream_stop_internal(stream);
+    }
+  }
+
+  context->reconfigure_pending = false;
+  audiounit_notify_device_changed(context);
+
+  for (cubeb_stream * stream : context->streams) {
+    auto_lock lock(stream->mutex);
+    audiounit_close_stream(stream);
+  }
+
+  vector<cubeb_stream *> failed;
+  for (cubeb_stream * stream : context->streams) {
+    if (stream->destroy_pending) {
+      continue;
+    }
+
+    auto_lock lock(stream->mutex);
+    if (audiounit_setup_stream(stream) != CUBEB_OK) {
+      audiounit_close_stream(stream);
+      stream->shutdown = true;
+      failed.push_back(stream);
+    }
+  }
+
+  context->reconfiguring = false;
+
+  for (cubeb_stream * stream : context->streams) {
+    if (stream->shutdown || stream->destroy_pending) {
+      continue;
+    }
+
+    if (stream->suspended) {
+      continue;
+    }
+
+    if (audiounit_stream_start_internal(stream) != CUBEB_OK) {
+      stream->shutdown = true;
+      audiounit_stream_stop_internal(stream);
+      failed.push_back(stream);
+    }
+  }
+
+  for (cubeb_stream * stream : failed) {
+    if (!stream->destroy_pending) {
+      stream->state_callback(stream, stream->user_ptr, CUBEB_STATE_ERROR);
+    }
+  }
+
+  cubeb_ios_update_audio_route(context);
+}
+
+static void
+audiounit_reconfigure_async(cubeb * context)
+{
+  if (context->reconfigure_pending.exchange(true)) {
+    return;
+  }
+
+  dispatch_async(context->serial_queue, ^() {
+    auto_lock lock(context->mutex);
+    audiounit_reconfigure_context(context);
+  });
+}
+
+static void
+audiounit_handle_route_change(void * user_ptr)
+{
+  cubeb * context = static_cast<cubeb *>(user_ptr);
+  auto_lock lock(context->mutex);
+
+  cubeb_device_type changed = cubeb_ios_update_device_collection(context);
+  if ((changed & CUBEB_DEVICE_TYPE_INPUT) &&
+      context->input_collection_changed_callback) {
+    context->input_collection_changed_callback(
+        context, context->input_collection_changed_user_ptr);
+  }
+
+  if ((changed & CUBEB_DEVICE_TYPE_OUTPUT) &&
+      context->output_collection_changed_callback) {
+    context->output_collection_changed_callback(
+        context, context->output_collection_changed_user_ptr);
+  }
+
+  if (cubeb_ios_update_audio_route(context)) {
+    context->reconfigure_pending = true;
+    audiounit_reconfigure_context(context);
+  }
+}
+
+static void
+audiounit_handle_media_services_reset(void * user_ptr)
+{
+  cubeb * context = static_cast<cubeb *>(user_ptr);
+  auto_lock context_lock(context->mutex);
+
+  context->interrupted = true;
+  context->reset_pending = true;
+
+  for (cubeb_stream * stream : context->streams) {
+    audiounit_stream_stop_internal(stream);
+  }
+
+  audiounit_notify_device_changed(context);
+
+  for (cubeb_stream * stream : context->streams) {
+    auto_lock lock(stream->mutex);
+    stream->shutdown = true;
+    audiounit_close_stream(stream);
+  }
+
+  context->reconfigure_pending = true;
+  cubeb_ios_update_audio_route(context);
+}
+
+static void
+audiounit_handle_interruption(void * user_ptr, bool interrupted,
+                              bool should_resume)
+{
+  cubeb * context = static_cast<cubeb *>(user_ptr);
+  auto_lock lock(context->mutex);
+
+  if (context->reset_pending) {
+    return;
+  }
+
+  if (!interrupted && !should_resume) {
+    return;
+  }
+
+  context->interrupted = interrupted;
+
+  if (interrupted) {
+    for (cubeb_stream * stream : context->streams) {
+      if (stream->shutdown || stream->destroy_pending) {
+        continue;
+      }
+
+      if (stream->suspended) {
+        continue;
+      }
+
+      audiounit_stream_stop_internal(stream);
+      stream->suspended = true;
+    }
+
+    audiounit_notify_device_changed(context);
+
+    return;
+  }
+
+  audiounit_reconfigure_context(context);
+
+  for (cubeb_stream * stream : context->streams) {
+    if (stream->shutdown || stream->destroy_pending) {
+      continue;
+    }
+
+    if (!stream->suspended) {
+      continue;
+    }
+
+    if (audiounit_stream_start_internal(stream) != CUBEB_OK) {
+      stream->shutdown = true;
+      audiounit_stream_stop_internal(stream);
+      stream->state_callback(stream, stream->user_ptr, CUBEB_STATE_ERROR);
+    }
+  }
+}
