+#if TARGET_OS_IPHONE
+static OSStatus
+audiounit_voice_output_callback(void * user_ptr,
+                                AudioUnitRenderActionFlags * flags,
+                                AudioTimeStamp const * tstamp, UInt32 bus,
+                                UInt32 frames, AudioBufferList * buffers)
+{
+  cubeb_stream * voice = static_cast<cubeb_stream *>(user_ptr);
+  cubeb * context = voice->context;
+  UInt32 byte_count = frames * voice->output_desc.mBytesPerFrame;
+  if (byte_count > context->mix_buffer.size()) {
+    audiounit_request_reconfiguration(voice, frames);
+    audiounit_make_silent(&buffers->mBuffers[0]);
+    *flags |= kAudioUnitRenderAction_OutputIsSilence;
+    return noErr;
+  }
+
+  if (has_output(voice)) {
+    audiounit_output_callback(voice, flags, tstamp, bus, frames, buffers);
+  } else {
+    audiounit_make_silent(&buffers->mBuffers[0]);
+  }
+
+  std::unique_lock<std::mutex> lock(context->output_mutex, std::try_to_lock);
+  if (!lock.owns_lock()) {
+    return noErr;
+  }
+
+  if (context->output_streams.empty()) {
+    return noErr;
+  }
+
+  size_t sample_count = frames * voice->output_desc.mChannelsPerFrame;
+  bool is_float = voice->output_desc.mFormatFlags & kAudioFormatFlagIsFloat;
+
+  for (cubeb_stream * stream : context->output_streams) {
+    AudioBufferList stream_buffer;
+    stream_buffer.mNumberBuffers = 1;
+    stream_buffer.mBuffers[0].mNumberChannels =
+        voice->output_desc.mChannelsPerFrame;
+    stream_buffer.mBuffers[0].mDataByteSize = byte_count;
+    stream_buffer.mBuffers[0].mData = context->mix_buffer.data();
+
+    AudioUnitRenderActionFlags render_flags = 0;
+    OSStatus r = AudioUnitRender(stream->output_converter, &render_flags,
+                                 tstamp, AU_OUT_BUS, frames, &stream_buffer);
+    if (r != noErr) {
+      if (r == kAudioUnitErr_TooManyFramesToProcess) {
+        audiounit_request_reconfiguration(voice, frames);
+        continue;
+      }
+
+      if (r == kAudioUnitErr_CannotDoInCurrentContext) {
+        audiounit_reconfigure_async(context);
+        continue;
+      }
+
+      audiounit_stop_and_notify_from_callback(stream, CUBEB_STATE_ERROR);
+      continue;
+    }
+
+    if (render_flags & kAudioUnitRenderAction_OutputIsSilence) {
+      continue;
+    }
+
+    if (is_float) {
+      float * output_samples = static_cast<float *>(buffers->mBuffers[0].mData);
+      const float * stream_samples =
+          static_cast<const float *>(stream_buffer.mBuffers[0].mData);
+      for (size_t i = 0; i < sample_count; ++i) {
+        output_samples[i] += stream_samples[i];
+      }
+    } else {
+      int16_t * output_samples =
+          static_cast<int16_t *>(buffers->mBuffers[0].mData);
+      const int16_t * stream_samples =
+          static_cast<const int16_t *>(stream_buffer.mBuffers[0].mData);
+      for (size_t i = 0; i < sample_count; ++i) {
+        int sample = int(output_samples[i]) + int(stream_samples[i]);
+        output_samples[i] = std::max(-32768, std::min(32767, sample));
+      }
+    }
+  }
+
+  if (is_float) {
+    float * output_samples = static_cast<float *>(buffers->mBuffers[0].mData);
+    for (size_t i = 0; i < sample_count; ++i) {
+      output_samples[i] = std::max(-1.0f, std::min(1.0f, output_samples[i]));
+    }
+  }
+
+  *flags &= ~kAudioUnitRenderAction_OutputIsSilence;
   return noErr;
 }
 
