diff --git a/gfx/layers/apz/src/AsyncPanZoomController.cpp b/gfx/layers/apz/src/AsyncPanZoomController.cpp
index 15d4ea258fbb..2c6bce0d9aa0 100644
--- a/gfx/layers/apz/src/AsyncPanZoomController.cpp
+++ b/gfx/layers/apz/src/AsyncPanZoomController.cpp
@@ -2810,6 +2810,7 @@ nsEventStatus AsyncPanZoomController::OnPanMayBegin(
   APZC_LOG_DETAIL("got a pan-maybegin in state %s\n", this,
                   ToString(mState).c_str());
 
+  mPanGestureMayStartTime = Some(aEvent.mTimeStamp);
   StartTouch(aEvent.mLocalPanStartPoint, aEvent.mTimeStamp);
   MOZ_ASSERT(GetCurrentPanGestureBlock());
   GetCurrentPanGestureBlock()->GetOverscrollHandoffChain()->CancelAnimations(
@@ -2825,6 +2826,7 @@ nsEventStatus AsyncPanZoomController::OnPanCancelled(
 
   mX.CancelGesture();
   mY.CancelGesture();
+  mPanGestureMayStartTime = Nothing();
 
   MOZ_ASSERT(GetCurrentPanGestureBlock());
   GetCurrentPanGestureBlock()
@@ -2846,6 +2848,14 @@ nsEventStatus AsyncPanZoomController::OnPanBegin(
   GetCurrentPanGestureBlock()->GetOverscrollHandoffChain()->CancelAnimations(
       ExcludeOverscroll);
 
+  if (aEvent.mType == PanGestureInput::PANGESTURE_START) {
+    mTouchStartRestingTimeBeforePan =
+        mPanGestureMayStartTime
+            ? aEvent.mTimeStamp - *mPanGestureMayStartTime
+            : TimeDuration();
+    mPanGestureMayStartTime = Nothing();
+    mMinimumVelocityDuringPan = Nothing();
+  }
   StartTouch(aEvent.mLocalPanStartPoint, aEvent.mTimeStamp);
 
   if (!UsingStatefulAxisLock()) {
@@ -3106,6 +3116,13 @@ nsEventStatus AsyncPanZoomController::OnPan(
