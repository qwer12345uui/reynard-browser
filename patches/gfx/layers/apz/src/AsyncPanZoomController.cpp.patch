+    if (!aEvent.mAllowFlingAcceleration) {
+      mFlingAccelerator.Reset();
+    }
     return HandleEndOfPan();
   }
 
@@ -3265,6 +3285,7 @@ nsEventStatus AsyncPanZoomController::OnPanInterrupted(
